# The app environment the browser suite runs against: playwright.config.ts appends these to its
# uvicorn command, and CI passes the same file to `docker run --env-file`. The fake nova answers
# instantly, so a solve that is going nowhere (fake-nova's 'timeout' mode, solve-failure.spec.ts)
# reaches the deadline in seconds instead of the default 15 minutes.
ASTROCAPTION_SOLVE_TIMEOUT_SECONDS=12
ASTROCAPTION_SOLVE_POLL_SECONDS=1
# Chunked uploads (#166): 1 MB chunks so the 2 MB PNG chunked-upload.spec.ts builds goes up in
# several requests; the default 16 MB would need a fixture too big to keep in the repo.
ASTROCAPTION_UPLOAD_CHUNK_MB=1
